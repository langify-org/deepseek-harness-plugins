{
  "name": "deepseek-harness-plugins",
  "private": true,
  "description": "Plugins for DeepSeek Harness, developed to one shared standard",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:compat": "pnpm -r --if-present run test:compat",
    "test:integration": "pnpm -r --if-present run test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:compat"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
