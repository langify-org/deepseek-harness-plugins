{
  "name": "langify-dsh-plugins",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugins published under the @langify npm scope",
  "license": "MIT",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" run build",
    "typecheck": "pnpm -r --filter \"./plugins/*\" run typecheck",
    "test": "pnpm -r --filter \"./plugins/*\" run test",
    "check": "pnpm run docs:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "docs:check": "node scripts/i18n.mjs",
    "docs:record": "node scripts/i18n.mjs --write",
    "e2e": "node e2e/session-hooks/run.mjs",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
