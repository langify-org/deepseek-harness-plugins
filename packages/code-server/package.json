{
  "name": "@langify-org/dsh-code-server",
  "version": "0.1.1",
  "description": "Edit the session's working folder in code-server inside DeepSeek Harness, served through DSH's authenticated web server",
  "keywords": [
    "code-server",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vscode"
  ],
  "homepage": "https://github.com/langify-org/deepseek-harness-plugins/tree/main/packages/code-server#readme",
  "bugs": "https://github.com/langify-org/deepseek-harness-plugins/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langify-org/deepseek-harness-plugins.git",
    "directory": "packages/code-server"
  },
  "files": [
    "dist",
    "extension/dsh-code-bridge.vsix",
    "cordis.patch.yml",
    "README*.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && cd extension && vsce package --no-dependencies --skip-license --out dsh-code-bridge.vsix",
    "typecheck": "tsc -p src/client"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-workspace-path": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-dockkit": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@deepseek-ai/dsh-working-directory": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/react": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
