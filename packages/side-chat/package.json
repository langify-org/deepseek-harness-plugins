{
  "name": "@langify-org/dsh-side-chat",
  "version": "0.1.0",
  "description": "Ask a side question beside a DeepSeek Harness conversation, in a fork shown in the right sidebar",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "side-chat"
  ],
  "homepage": "https://github.com/langify-org/deepseek-harness-plugins/tree/main/packages/side-chat#readme",
  "bugs": "https://github.com/langify-org/deepseek-harness-plugins/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langify-org/deepseek-harness-plugins.git",
    "directory": "packages/side-chat"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README*.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p src/client"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-chat": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
