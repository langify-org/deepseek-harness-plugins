{
  "name": "@langify-org/dsh-tasks",
  "version": "0.1.0",
  "description": "Run justfile recipes from a Tasks tab in DeepSeek Harness's right sidebar, in a terminal tab",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "just",
    "justfile",
    "tasks"
  ],
  "homepage": "https://github.com/langify-org/deepseek-harness-plugins/tree/main/packages/tasks#readme",
  "bugs": "https://github.com/langify-org/deepseek-harness-plugins/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langify-org/deepseek-harness-plugins.git",
    "directory": "packages/tasks"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README*.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p src/client"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-terminal-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-terminal": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-working-directory": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal"
      ]
    }
  }
}
