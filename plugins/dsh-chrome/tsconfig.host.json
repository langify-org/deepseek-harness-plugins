{
  // Code that runs on Node: the host plugin, the native host relay, the build, and tests.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src/protocol", "src/host", "src/native-host", "test", "build.ts"],
  // Tests of extension code need Chrome's types; tsconfig.extension-test.json checks them.
  "exclude": ["test/unit/extension"]
}
