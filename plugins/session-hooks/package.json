{
  "name": "@langify-org/dsh-session-hooks",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin that runs your shell commands when a session starts, is archived, or is unarchived",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.ja.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hooks",
    "session",
    "worktree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langify-org/deepseek-harness-plugins.git",
    "directory": "plugins/session-hooks"
  },
  "homepage": "https://github.com/langify-org/deepseek-harness-plugins/tree/main/plugins/session-hooks#readme",
  "bugs": {
    "url": "https://github.com/langify-org/deepseek-harness-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@deepseek-ai/* --outfile=lib/index.js --log-level=warning",
    "watch": "pnpm run build:js --watch=forever",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "esbuild-wasm": "catalog:",
    "js-yaml": "catalog:",
    "typescript": "catalog:"
  }
}
