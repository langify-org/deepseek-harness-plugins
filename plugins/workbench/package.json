{
  "name": "@langify-org/dsh-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek Harness plugin that creates named places to work (git worktrees registered as Workspaces) before a conversation starts",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "worktree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langify-org/deepseek-harness-plugins.git",
    "directory": "plugins/workbench"
  },
  "homepage": "https://github.com/langify-org/deepseek-harness-plugins/tree/main/plugins/workbench#readme",
  "bugs": {
    "url": "https://github.com/langify-org/deepseek-harness-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js && pnpm run build:client",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@deepseek-ai/* --outfile=lib/index.js --log-level=warning",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild-wasm": "catalog:",
    "typescript": "catalog:"
  }
}
