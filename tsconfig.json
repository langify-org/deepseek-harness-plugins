{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["*.ts", "scripts", "packages/*/src", "packages/*/*.config.ts"],
  // Browser halves need DOM types and their own Context augmentations: see src/client/tsconfig.json.
  "exclude": ["packages/*/src/client"]
}
